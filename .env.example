# All values are optional: without them the site uses the dummy placeholders in lib/site.ts.

# Public site origin, no trailing slash. Used for canonical URLs, sitemap and Open Graph.
SITE_URL=https://www.example.com

# Contact details shown on the site.
NEXT_PUBLIC_CONTACT_EMAIL=info@techvedha.tech
NEXT_PUBLIC_CONTACT_PHONE=+91 98765 43210

# WhatsApp number, international format (digits only). Defaults to the contact phone.
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210
