# All values are optional: without them the site uses the dummy placeholders in lib/site.ts.
# Local: copy this file to .env (localhost URLs below). It is never uploaded to Vercel.
# Vercel (Project → Settings → Environment Variables): ADMIN_API_URL=https://<admin project>.vercel.app,
# REVALIDATE_SECRET and MEDIA_HOSTNAMES. SITE_URL is optional there (see below).
# How each value links to Tech-Vedha-Admin: LINKING.md.

# Public site origin, no trailing slash. Used for canonical URLs, sitemap and Open Graph.
# Unset: http://localhost:3002 locally, this project's production domain on Vercel (automatic).
# Set it only for a custom domain, e.g. https://www.techvedha.tech
SITE_URL=

# Contact details shown on the site.
NEXT_PUBLIC_CONTACT_EMAIL=info@techvedha.tech
NEXT_PUBLIC_CONTACT_PHONE=+91 98765 43210
 
# WhatsApp number, international format (digits only). Defaults to the contact phone.
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# ── Tech-Vedha-Admin (CMS) ───────────────────────────────────────────────────
# Origin of the admin, no trailing slash. Locally defaults to http://localhost:3000.
# On Vercel: the admin's URL, e.g. https://<admin project>.vercel.app
# Without it a production build serves the bundled copy in data/ (the site still works).
ADMIN_API_URL=http://localhost:3000

# Shared secret: the admin sends it when it asks this site to refresh content (POST /api/revalidate),
# and this site sends it with enquiry forms. Must equal REVALIDATE_SECRET in Tech-Vedha-Admin.
# Generate one with: openssl rand -hex 32
REVALIDATE_SECRET=

# Hosts of images uploaded in the admin's Media Library (comma-separated), e.g. media.techvedha.tech
MEDIA_HOSTNAMES=
